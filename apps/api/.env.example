# Copy to .env for local development. Never commit a real .env.
# Matches the local database in infrastructure/docker/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://code2prod:code2prod@localhost:5432/code2prod

# development | staging | production
ENVIRONMENT=development

# Required outside development — the app refuses to start with the dev default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Access tokens are stateless, so this is the worst-case delay between revoking
# a session and it actually dying. Keep it short.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
